# Puerto HTTP donde escucha la API (el WebSocket comparte el mismo puerto en /ws)
PORT=3000

# Motor de persistencia: "sqlite" (definitivo) o "memory" (Entrega 1 / pruebas)
PERSISTENCE=sqlite

# Ruta del archivo SQLite (se crea automáticamente)
SQLITE_PATH=./data/subastas.sqlite

# Secreto para firmar los tokens de sesión (JWT). Usa una cadena larga y aleatoria.
JWT_SECRET=
# Vigencia del token, en formato de jsonwebtoken (ej: 2h, 1d)
JWT_EXPIRES_IN=2h

# Costo de bcrypt para cifrar contraseñas
BCRYPT_ROUNDS=10

# Secreto compartido con la pasarela de pagos para firmar el webhook (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=
# Antigüedad máxima aceptada de una notificación firmada, en segundos
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# URL base que usan los scripts de apoyo (simulador de pasarela y cliente WebSocket)
API_BASE_URL=http://localhost:3000

# SOLO DEMOSTRACIONES: habilita /api/dev/clock para adelantar el reloj del negocio
# (permite mostrar cierre y vencimiento sin esperar horas). Mantener en false.
DEV_CLOCK_ENABLED=false
