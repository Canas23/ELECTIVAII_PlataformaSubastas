{
  "name": "subastas-api",
  "version": "1.0.0",
  "description": "Plataforma de Subastas en Línea - API REST + WebSockets + Webhook (Arquitectura hexagonal)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:domain": "node scripts/check-domain-imports.mjs",
    "gateway:simulate": "tsx scripts/simulate-payment.ts",
    "ws:client": "tsx scripts/ws-client.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
